// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

model Comanda {
  id Int @id @default(autoincrement())
  titlu String
  descriere String?
  categorie String
  suma Float
  status StatusComanda @default(CREATA)
  dataCrearii DateTime @default(now())
  comentariuRespingere String?
  utilizatorId Int 
  utilizator Utilizator @relation(fields: [utilizatorId], references: [id])
}

model Utilizator {
  id Int @id @default(autoincrement())
  nume String
  email String @unique
  parola String
  rol Rol @default(CLIENT)
  dataCrearii DateTime @default(now()) 
  comenzi Comanda[]
}

enum Rol {
   CLIENT
   MANAGER
   IT
   FINANCIAR
   ADMIN
}

enum StatusComanda {
  CREATA
  APROBARE_MANAGER
  APROBARE_IT
  APROBARE_FINANCIAR
  FACTURATA
  FINALIZATA
  NECESITA_RELUCRARE
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url= env("DATABASE_URL")
}

